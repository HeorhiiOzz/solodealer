{
  "cleanUrls": true,
  "rewrites": [
    {"source": "/api/upload", "destination": "/api/catalog?op=upload"},
    {"source": "/api/leads", "destination": "/api/clients?op=lead"},
    {"source": "/sitemap.xml", "destination": "/api/sitemap"},
    {"source": "/avto-bez-pershoho-vnesku", "destination": "/api/seo-landing?slug=avto-bez-pershoho-vnesku"},
    {"source": "/avto-z-minimalnym-pershym-vneskom", "destination": "/api/seo-landing?slug=avto-z-minimalnym-pershym-vneskom"},
    {"source": "/avto-pry-neidealnii-kredytnii-istorii", "destination": "/api/seo-landing?slug=avto-pry-neidealnii-kredytnii-istorii"},
    {"source": "/avto-pid-vyplatu-dlia-taksi", "destination": "/api/seo-landing?slug=avto-pid-vyplatu-dlia-taksi"},
    {"source": "/auto/:id", "destination": "/api/video-chunk?op=vehicle&id=:id"}
  ],
  "headers": [
    {"source": "/admin", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/crm", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/telegram", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/api/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]}
  ],
  "functions": {
    "api/video-chunk.js": {
      "maxDuration": 60
    },
    "api/reminder-worker.mjs": {
      "maxDuration": 30,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "client-reminders",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  }
}
